# --- data -------------------------------------------------------------------
# Raw Kaggle download (219MB, and redistributing a scrape is not ours to do).
# Reproduce with:
#   kaggle datasets download -d davidcariboo/player-scores -p data/raw --unzip
data/raw/

# Derived tables -- regenerate with `python 01-value-predictor/clean.py`.
# The 498-row modelling table is committed as an exception so the repo is
# self-contained: a fresh clone can run eda.py, model.py and the app without
# first pulling 219MB from Kaggle.
#
# Note the trailing /* rather than a plain directory rule. Git cannot
# re-include a file whose parent directory is excluded, so `data/processed/`
# followed by a negation would silently keep ignoring the CSV. Excluding the
# directory *contents* leaves the directory itself readable, which lets the
# negation take effect.
data/processed/*
!data/processed/pl_player_values.csv

# --- credentials ------------------------------------------------------------
# The Kaggle API token lives at ~/.kaggle/kaggle.json, which is OUTSIDE this
# repo, so git would never see it regardless. These patterns are belt-and-
# braces in case a token is ever copied into the working tree.
.kaggle/
kaggle.json
*.pem
*.key

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/

# --- environments -----------------------------------------------------------
venv/
.venv/
env/
ENV/
.env
.env.*

# --- tooling / os -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
