# Dependencies and build output. api-types.d.ts is deliberately NOT ignored:
# it is generated from the backend's /openapi.json but committed, so a drift
# between the two shows up as a dirty diff after `npm run gen:types`.
node_modules/
dist/
.vite/
*.local
# `tsc -b` in `npm run build` always writes tsconfig.tsbuildinfo beside
# tsconfig.json, even with noEmit.
*.tsbuildinfo
# Generated from the committed artefacts by backend/tests/export_ui_fixtures.py
# on every run, and never committed: a copy would be a second source of truth.
tests/e2e/.fixtures/
